#include <windows.h>
#include <commctrl.h>
#include "_build/resource_data.rc2"
1 VERSIONINFO
FILEVERSION 2,0,1,0
PRODUCTVERSION 2,0,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "szzhang\0"
   VALUE "FileDescription", "FPGA safe bit packaging tool\0"
   VALUE "FileVersion", "2.0.1\0"
   VALUE "InternalName", "pack_bit\0"
   VALUE "OriginalFilename", "pack_bit.exe\0"
   VALUE "ProductName", "Bit_pack\0"
   VALUE "ProductVersion", "2.0.1\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
/* Captions are set at runtime (UTF-8 C source). Header y<40, footer y>=180: painted in pack_bit.c. */
102 DIALOGEX 0, 0, 420, 208
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Bit_pack"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
 LTEXT "", 1016, 12, 8, 396, 15, SS_NOPREFIX
 LTEXT "", 1015, 12, 24, 396, 10, SS_NOPREFIX
 LTEXT "Project:", 1003, 12, 50, 50, 13, SS_CENTERIMAGE
 EDITTEXT 1001, 64, 50, 140, 13, ES_AUTOHSCROLL
 LTEXT "Source:", 1004, 12, 72, 50, 13, SS_CENTERIMAGE
 COMBOBOX 1002, 64, 72, 222, 200, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "File...", 1007, 290, 71, 54, 15
 PUSHBUTTON "Scan...", 1011, 348, 71, 60, 15
 LTEXT "Output:", 1009, 12, 94, 50, 13, SS_CENTERIMAGE
 EDITTEXT 1008, 64, 94, 280, 13, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1010, 348, 93, 60, 15
 AUTOCHECKBOX "Copy only", 1006, 64, 116, 220, 13, WS_TABSTOP
 RTEXT "Timeout:", 1014, 290, 116, 54, 13, SS_CENTERIMAGE
 EDITTEXT 1013, 348, 116, 42, 13, ES_NUMBER | ES_CENTER | ES_AUTOHSCROLL
 LTEXT "s", 1019, 394, 116, 14, 13, SS_CENTERIMAGE
 CONTROL "", 1012, "msctls_progress32", PBS_MARQUEE | NOT WS_VISIBLE, 12, 137, 396, 4
 LTEXT "", 1005, 12, 145, 396, 21, SS_NOPREFIX
 CONTROL "", 1017, "SysLink", LWS_TRANSPARENT | WS_TABSTOP | NOT WS_VISIBLE, 12, 166, 240, 10
 LTEXT "", 1018, 12, 186, 270, 15, SS_CENTERIMAGE | SS_NOPREFIX
 DEFPUSHBUTTON "Start", 1, 290, 186, 64, 15
 PUSHBUTTON "Close", 2, 358, 186, 50, 15
END
